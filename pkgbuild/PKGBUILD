pkgname=orbit
pkgver=0.1.0
pkgrel=1
pkgdesc='Radial launcher at the pointer: apps and nested folders in one orbit'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-svg' 'qt6-wayland' 'hyprland')
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/orbit "$pkgdir/usr/bin/orbit"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/orbit.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/orbit.svg"
  install -Dm644 "$startdir/orbit.desktop" "$pkgdir/usr/share/applications/orbit.desktop"
}
